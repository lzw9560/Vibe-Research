# VibeResearch 后端可选配置。
# 本地自托管：全部留空即可（开箱开放）。公网部署：务必设置下面两项。
# 用法：复制为 .env，或直接 export 这些环境变量后再起服务。
# ── 安全（公网部署必设） ─────────────────────────────────────────────
# CORS 白名单，逗号分隔。默认 "*"（放开，适合本地）。公网收紧成你的前端域名：
#   VR_ALLOW_ORIGINS=https://your-frontend-host
# AI：无需在此配置。用户在网页「接入 AI」页填自己的 key（存本地浏览器），
#     或用订阅接入调本机已登录的 CLI（Claude Code / Codex / Qwen / Gemini / DeepSeek）。
# envsitter: StepFun（阶跃星辰）API key，用于接入 stepfun 模型
STEPFUN_API_KEY=
VR_ALLOW_ORIGINS=*
# 鉴权 key。一旦设置，所有 /api/*（除 /api/health）都需带 Authorization: Bearer <key>。
# 本地留空=开放；公网部署务必设一个强随机值（否则别人能读你的持仓、调你的后端）：
#   VR_API_KEY=$(openssl rand -hex 32)
VR_API_KEY=



# ── OmniRoute 托底通道（可选） ───────────────────────────────────────
# 启用后，AI 对话会先走本地 OmniRoute 网关，自动切换最便宜的可用模型。
# 需先安装并运行 OmniRoute：npm i -g omniroute，或使用 docker compose --profile omniroute up -d
# VR_OMNIRoute_ENABLED=false
# VR_OMNIRoute_MODEL=auto
# VR_OMNIRoute_BASE_URL=http://localhost:20128

# ── 数据源（可选） ───────────────────────────────────────────────────
# 行情/研报/公告/资金面等零 key 即用；仅 iwencai 语义搜索研报需要 key：
# IWENCAI_API_KEY=
# IWENCAI_BASE_URL=https://openapi.iwencai.com

# 代理：默认不用管。东财等国内数据源**默认直连**（自动绕开你的科学上网/Clash 代理，
# 因为国内财经站走翻墙代理反而会连不上，如 push2.eastmoney.com）。
# 仅当你的机器「只能靠代理才能出网」时，才设为 1 强制走系统代理：
# VR_DATA_PROXY=1

# ── LimitUp 投研助手（可选） ───────────────────────────────────────────
# 盘后预计算开关（交易日 15:35 自动预计算最近 3 个交易日数据）
# LIMITUP_PRECOMPUTE=false

# 竞价选股参数
# AUCTION_MIN_GENE_SCORE=50
# AUCTION_MIN_ZT_COUNT=2
# AUCTION_TOP_N=50

# ── 通知推送（可选） ───────────────────────────────────────────────────
# 飞书（二选一或同时配置）
#   - Webhook 模式：仅需 FEISHU_WEBHOOK_URL
#   - App Bot 模式：需配置 FEISHU_APP_ID / FEISHU_APP_SECRET / FEISHU_CHAT_ID
#   - 同时配置时，默认走 Webhook；设置 FEISHU_PREFER_APP_BOT=true 优先走 App Bot
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_CHAT_ID=
# FEISHU_WEBHOOK_URL=
# FEISHU_STREAM_ENABLED=false
# FEISHU_PREFER_APP_BOT=false

# 钉钉
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# DINGTALK_SECRET=
# DINGTALK_STREAM_ENABLED=false
# DINGTALK_WEBHOOK_URL=

# 邮件通知
# MERGE_EMAIL_NOTIFICATION=false

# 涨停板通知
# SEAL_PLATE_NOTIFICATION_ENABLED=false

# 单股通知
# SINGLE_STOCK_NOTIFY=false

